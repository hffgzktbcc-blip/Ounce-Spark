+fn f16_bits_to_f64(bits: u16) -> f64 {
+    let (sign, exp, man) = ((bits >> 15) & 1, ((bits >> 10) & 0x1F) as i32, (bits & 0x3FF) as f64);
+    let magnitude = match exp {
+        0 => man * 2f64.powi(-24),
+        0x1F if man == 0.0 => f64::INFINITY,
+        0x1F => f64::NAN,
+        _ => (1.0 + man / 1024.0) * 2f64.powi(exp - 15),
+    };
+    if sign == 1 { -magnitude } else { magnitude }
+}
+
+/// Execute one warp's `mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32`.
+///
+/// Assumption (from model memory, not yet checked against the PTX figures): in a packed `.f16x2` fragment register the
+/// element with the lower index sits in bits 15:0 and the next one in bits 31:16.
+fn warp_mma_m16n8k16_f16_f32(lanes: &mut [(usize, Instruction, ThreadState)]) -> VmResult<()> {
+    use spark_num::mma::{lane_a_coords, lane_b_coords, lane_cd_coords, mma_ref_f32, MmaShape};
+    let shape = MmaShape { m: 16, n: 8, k: 16 };
+    let Instruction::MmaSyncM16N8K16F16F32 { d, a, b, c } = lanes[0].1.clone() else {
+        unreachable!("only mma instructions are parked");
+    };
+    let first = format!("{:?}", lanes[0].1);
+    if lanes.iter().any(|(_, inst, _)| format!("{inst:?}") != first) {
+        return Err(VmError::IncompleteWarp(0));
+    }
+    let (mut amat, mut bmat, mut cmat) = (vec![0.0f64; 16 * 16], vec![0.0f64; 16 * 8], vec![0.0f32; 16 * 8]);
+    for (lane, _, st) in lanes.iter() {
+        let (ac, bc, cdc) = (lane_a_coords(shape, *lane).unwrap(), lane_b_coords(shape, *lane).unwrap(), lane_cd_coords(*lane));
+        for (r, reg) in a.iter().enumerate() {
+            let word = st.get_u32((*reg).into());
+            for (half, bits) in [(0, word as u16), (1, (word >> 16) as u16)] {
+                let (row, col) = ac[2 * r + half];
+                amat[row * 16 + col] = f16_bits_to_f64(bits);
+            }
+        }
+        for (r, reg) in b.iter().enumerate() {
+            let word = st.get_u32((*reg).into());
+            for (half, bits) in [(0, word as u16), (1, (word >> 16) as u16)] {
+                let (row, col) = bc[2 * r + half];
+                bmat[row * 8 + col] = f16_bits_to_f64(bits);
+            }
+        }
+        for (r, reg) in c.iter().enumerate() {
+            let (row, col) = cdc[r];
+            cmat[row * 8 + col] = st.get_f32((*reg).into());
+        }
+    }
+    let dmat = mma_ref_f32(shape, &amat, &bmat, &cmat);
+    for (lane, _, st) in lanes.iter_mut() {
+        let cdc = lane_cd_coords(*lane);
+        for (r, reg) in d.iter().enumerate() {
+            let (row, col) = cdc[r];
+            st.set_f32(*reg, dmat[row * 8 + col]);
+        }
+    }
+    Ok(())
+}
diff --git a/tests/mma_spike.rs b/tests/mma_spike.rs
new file mode 100644
index 0000000..d3ee44c
--- /dev/null
+++ b/tests/mma_spike.rs
@@ -0,0 +1,131 @@
+//! Gate 2 spike: one warp executes a hand-written PTX kernel containing mma.sync m16n8k16 (f16 -> f32)
+//! and the result must match the spec-first oracle in oracles/data/mma.json.
+use ptoxide::{Argument, Context, LaunchParams};
+use serde_json::Value;
+
+const KERNEL: &str = include_str!("../../kernels/mma_m16n8k16_f16.ptx");
+
+fn oracle() -> Value {
+    let path = format!("{}/../../../oracles/data/mma.json", env!("CARGO_MANIFEST_DIR"));
+    serde_json::from_str(&std::fs::read_to_string(path).unwrap()).unwrap()
+}
+
+fn parse(s: &str) -> f64 {
+    match s {
+        "nan" => return f64::NAN,
+        "inf" => return f64::INFINITY,
+        "-inf" => return f64::NEG_INFINITY,
+        _ => {}
+    }
+    let (neg, rest) = s.strip_prefix('-').map_or((false, s), |r| (true, r));
+    let rest = rest.strip_prefix("0x").unwrap();
+    let (mant, exp) = rest.split_once('p').unwrap();
+    let (int, frac) = mant.split_once('.').unwrap_or((mant, ""));
+    let mut v = u64::from_str_radix(int, 16).unwrap() as f64;
+    let mut scale = 1.0 / 16.0;
+    for d in frac.chars() {
+        v += d.to_digit(16).unwrap() as f64 * scale;
+        scale /= 16.0;
+    }
+    let v = v * 2f64.powi(exp.parse::<i32>().unwrap());
+    if neg { -v } else { v }
+}
+
+fn floats(v: &Value) -> Vec<f64> {
+    v.as_array().unwrap().iter().map(|s| parse(s.as_str().unwrap())).collect()
+}
+
+/// Run the kernel on one oracle case and return D (16x8, row-major).
+fn run_case(case: &Value) -> Vec<f32> {
+    let a_bits: Vec<u16> = case["a_bits"].as_array().unwrap().iter().map(|x| x.as_u64().unwrap() as u16).collect();
+    let b_row_major: Vec<u16> = case["b_bits"].as_array().unwrap().iter().map(|x| x.as_u64().unwrap() as u16).collect();
+    // The kernel wants B column-major: element (r, c) at c*16 + r. The oracle stores B row-major: (r, c) at r*8 + c.
+    let mut b_col_major = vec![0u16; 16 * 8];
+    for r in 0..16 {
+        for c in 0..8 {
+            b_col_major[c * 16 + r] = b_row_major[r * 8 + c];
+        }
+    }
+    let c_vals: Vec<f32> = floats(&case["c"]).iter().map(|&x| x as f32).collect();
+
+    let mut ctx = Context::new_with_module(KERNEL).expect("kernel compiles");
+    let (da, db, dc, dd) = (ctx.alloc::<u16>(256), ctx.alloc::<u16>(128), ctx.alloc::<f32>(128), ctx.alloc::<f32>(128));
+    ctx.write(da, &a_bits);
+    ctx.write(db, &b_col_major);
+    ctx.write(dc, &c_vals);
+    ctx.run(
+        LaunchParams::func("mma_m16n8k16_f16").grid1d(1).block1d(32),
+        &[Argument::ptr(da), Argument::ptr(db), Argument::ptr(dc), Argument::ptr(dd)],
+    )
+    .expect("kernel runs");
+    let mut d = vec![0f32; 128];
+    ctx.read(dd, &mut d);
+    d
+}
+
+fn cases(class: &str) -> Vec<Value> {
+    oracle()["cases"].as_array().unwrap().iter().filter(|c| c["a_fmt"] == "f16" && c["shape"] == serde_json::json!([16, 8, 16]) && c["class"] == class).cloned().collect()
+}
+
+#[test]
+fn exact_cases_match_bit_for_bit() {
+    let cs = cases("exact");
+    assert_eq!(cs.len(), 8);
+    for case in cs {
+        let want: Vec<f32> = floats(&case["expected"]).iter().map(|&x| x as f32).collect();
+        let got = run_case(&case);
+        for (i, (g, w)) in got.iter().zip(&want).enumerate() {
+            assert!((*g == 0.0 && *w == 0.0) || g.to_bits() == w.to_bits(), "{} element {i}: got {g}, want {w}", case["id"]);
+        }
+    }
+}
+
+#[test]
+fn banded_cases_stay_inside_their_band() {
+    let cs = cases("banded");
+    assert_eq!(cs.len(), 12);
+    for case in cs {
+        let (want, band) = (floats(&case["expected"]), floats(&case["band"]));
+        let got = run_case(&case);
+        for i in 0..128 {
+            let err = (got[i] as f64 - want[i]).abs();
+            assert!(err <= band[i], "{} element {i}: error {err:e} exceeds band {:e}", case["id"], band[i]);
+        }
+    }
+}
+
+fn launch(kernel: &str, threads: u32) -> Result<(), String> {
+    let mut ctx = Context::new_with_module(kernel).map_err(|e| e.to_string())?;
+    let (da, db, dc, dd) = (ctx.alloc::<u16>(256), ctx.alloc::<u16>(128), ctx.alloc::<f32>(128), ctx.alloc::<f32>(128));
+    ctx.write(da, &[0u16; 256]);
+    ctx.write(db, &[0u16; 128]);
+    ctx.write(dc, &[0f32; 128]);
+    ctx.run(
+        LaunchParams::func("mma_m16n8k16_f16").grid1d(1).block1d(threads),
+        &[Argument::ptr(da), Argument::ptr(db), Argument::ptr(dc), Argument::ptr(dd)],
+    )
+    .map_err(|e| e.to_string())
+}
+
+#[test]
+fn a_block_smaller_than_a_warp_is_an_error() {
+    let err = launch(KERNEL, 16).unwrap_err();
+    assert!(err.contains("needs all 32 lanes"), "{err}");
+}
+
+#[test]
+fn unsupported_type_combination_is_a_compile_error_not_a_guess() {
+    let kernel = KERNEL.replace("m16n8k16.row.col.f32.f16.f16.f32", "m16n8k16.row.col.f16.f16.f16.f16");
+    let err = launch(&kernel, 32).unwrap_err();
+    assert!(err.contains("implemented only for f32.f16.f16.f32"), "{err}");
+}
+
+#[test]
+fn a_lane_that_exits_before_the_mma_is_reported() {
+    let kernel = KERNEL
+        .replace(".reg .b64 %rd<12>;", ".reg .b64 %rd<12>;\n\t.reg .pred %p<2>;")
+        .replace("\tmma.sync", "\tsetp.lt.u32 %p0, %r8, 16;\n\t@%p0 bra $L_END;\n\tmma.sync")
+        .replace("\tret;", "$L_END:\n\tret;");
+    let err = launch(&kernel, 32).unwrap_err();
+    assert!(err.contains("did not reach the warp-collective instruction"), "{err}");
+}
